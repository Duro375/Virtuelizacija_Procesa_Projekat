<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
	<appSettings>
		<add key="path" value="Files"/>
		<add key="CurrentSpikeThreshold" value = "2"/>
	</appSettings>
	<system.serviceModel>
		<bindings>
			<netTcpBinding>
				<binding name="NetTcpStreamingBinding"
					maxReceivedMessageSize="104857600"
					transferMode="Streamed"
					receiveTimeout="00:10:00" 
					sendTimeout="00:10:00">
				</binding>
			</netTcpBinding>
		</bindings>
		<services>
			<service name="Server.ChargingService">
				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:4000"/>
					</baseAddresses>
				</host>
				<!-- Service Endpoints -->
				<endpoint
					address="ChargerService"
					binding="netTcpBinding"
					bindingConfiguration="NetTcpStreamingBinding"
					contract="Common.IChargingService" />
			</service>
		</services>
	</system.serviceModel>
</configuration>